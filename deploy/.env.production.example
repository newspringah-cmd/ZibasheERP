# Copy to .env.production on the VPS. Never commit the real file.
ConnectionStrings__DefaultConnection=Server=SQL_HOST,1433;Database=ZibasheERPDb;User Id=ZIBASHE_DB_USER;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False

ApiKeys__Admin=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
ApiKeys__TelegramBot=REPLACE_WITH_A_DIFFERENT_RANDOM_32_PLUS_CHARACTERS
ApiKeys__N8n=REPLACE_WITH_A_THIRD_RANDOM_32_PLUS_CHARACTERS

Telegram__Enabled=true
Telegram__BotToken=REPLACE_WITH_BOTFATHER_TOKEN
Telegram__WebhookSecret=REPLACE_WITH_RANDOM_WEBHOOK_SECRET
Telegram__AdminChatId=REPLACE_WITH_ADMIN_PRIVATE_OR_GROUP_CHAT_ID
Telegram__PollIntervalSeconds=10
Telegram__BatchSize=20
Telegram__MaxAttempts=5

N8n__Enabled=true
N8n__WebhookUrl=https://N8N_DOMAIN/webhook/zibashe-events
N8n__WebhookSecret=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
N8n__PollIntervalSeconds=10
N8n__BatchSize=20
N8n__MaxAttempts=8

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
