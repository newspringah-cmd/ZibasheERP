# Copy to .env.production on the VPS. Never commit the real file.
MSSQL_PID=Express
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_RANDOM_SQL_PASSWORD
MSSQL_APP_PASSWORD=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_APP_PASSWORD
MSSQL_MEMORY_LIMIT_MB=3072
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=ZibasheERPDb;User Id=zibashe_app;Password=REPLACE_WITH_THE_SAME_APP_PASSWORD;Encrypt=True;TrustServerCertificate=True

ApiKeys__Admin=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
ApiKeys__TelegramBot=REPLACE_WITH_A_DIFFERENT_RANDOM_32_PLUS_CHARACTERS
ApiKeys__N8n=REPLACE_WITH_A_THIRD_RANDOM_32_PLUS_CHARACTERS

Telegram__Enabled=true
Telegram__BotToken=REPLACE_WITH_BOTFATHER_TOKEN
Telegram__WebhookSecret=REPLACE_WITH_RANDOM_WEBHOOK_SECRET
Telegram__AdminChatId=REPLACE_WITH_ADMIN_PRIVATE_OR_GROUP_CHAT_ID
Telegram__SalesChannelId=REPLACE_WITH_MAIN_SALES_CHANNEL_ID_OR_USERNAME
Telegram__SalesDiscussionChatId=REPLACE_WITH_LINKED_DISCUSSION_GROUP_CHAT_ID
Telegram__SalesAuditChatId=REPLACE_WITH_SALES_AUDIT_GROUP_CHAT_ID
Telegram__CompletedSalesListsChatId=
Telegram__InvoiceFailureChatId=
Telegram__DecantChatId=
Telegram__LabelPrintChatId=
Telegram__NewPaymentsChatId=
Telegram__InventoryChatId=
Telegram__InvoiceGreetingStickerFileId=
Telegram__OwnerUserId=REPLACE_WITH_PRIMARY_OWNER_TELEGRAM_USER_ID
Telegram__PollIntervalSeconds=10
Telegram__BatchSize=20
Telegram__MaxAttempts=5

N8n__Enabled=true
N8n__WebhookUrl=https://N8N_DOMAIN/webhook/zibashe-events
N8n__WebhookSecret=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
N8n__PollIntervalSeconds=10
N8n__BatchSize=20
N8n__MaxAttempts=8

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
