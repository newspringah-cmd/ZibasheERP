# Copy to .env.n8n on the VPS. Never commit the real file.
N8N_DOMAIN=n8n.example.com
N8N_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
N8N_RUNNERS_AUTH_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_32_PLUS_CHARACTERS
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=true
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true
