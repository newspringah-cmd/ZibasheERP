@ZibasheERP.API_HostAddress = http://localhost:5143
@SalesListId = 55555555-5555-5555-5555-555555555555
@CustomerId = 44444444-4444-4444-4444-444444444444
@OrderId = 00000000-0000-0000-0000-000000000000
@TelegramApiKey = SET_FROM_A_SECURE_SOURCE
@AdminApiKey = SET_FROM_A_SECURE_SOURCE
@TelegramWebhookSecret = SET_FROM_A_SECURE_SOURCE

### Create order from Telegram
POST {{ZibasheERP.API_HostAddress}}/api/orders
Content-Type: application/json
X-Api-Key: {{TelegramApiKey}}

{
  "telegramId": "123456789",
  "salesListId": "{{SalesListId}}",
  "requestedVolumeMl": 10,
  "isBottleOwner": true,
  "bottleId": null,
  "notes": "ثبت‌شده از ربات تلگرام"
}

### Create order from admin panel
POST {{ZibasheERP.API_HostAddress}}/api/orders
Content-Type: application/json
X-Api-Key: {{AdminApiKey}}

{
  "customerId": "{{CustomerId}}",
  "salesListId": "{{SalesListId}}",
  "requestedVolumeMl": 10,
  "isBottleOwner": false,
  "bottleId": "33333333-3333-3333-3333-333333333333",
  "notes": "ثبت‌شده از پنل مدیریت"
}

### Get order details
GET {{ZibasheERP.API_HostAddress}}/api/orders/{{OrderId}}
Accept: application/json
X-Api-Key: {{AdminApiKey}}

### List invoiced orders for admin operations
GET {{ZibasheERP.API_HostAddress}}/api/orders?status=Invoiced&limit=50
Accept: application/json
X-Api-Key: {{AdminApiKey}}

### Cancel unpaid order by admin
POST {{ZibasheERP.API_HostAddress}}/api/orders/{{OrderId}}/cancel
Content-Type: application/json
X-Api-Key: {{AdminApiKey}}

{
  "reason": "لغو با درخواست مشتری"
}

### Get Telegram customer's orders
GET {{ZibasheERP.API_HostAddress}}/api/orders/by-telegram/123456789
Accept: application/json
X-Api-Key: {{TelegramApiKey}}

### Create customer address by admin
POST {{ZibasheERP.API_HostAddress}}/api/addresses/customer/{{CustomerId}}
Content-Type: application/json
X-Api-Key: {{AdminApiKey}}

{
  "receiverName": "نام گیرنده",
  "mobile": "09120000000",
  "province": "تهران",
  "city": "تهران",
  "postalCode": "1234567890",
  "fullAddress": "نشانی کامل مشتری",
  "description": "منزل",
  "isDefault": true
}

### Get customer addresses by admin
GET {{ZibasheERP.API_HostAddress}}/api/addresses/customer/{{CustomerId}}
Accept: application/json
X-Api-Key: {{AdminApiKey}}

### Submit payment receipt from Telegram
POST {{ZibasheERP.API_HostAddress}}/api/payments
Content-Type: application/json
X-Api-Key: {{TelegramApiKey}}

{
  "orderId": "{{OrderId}}",
  "amount": 4500000,
  "paymentMethod": "CardToCard",
  "transactionId": "BANK-REFERENCE-001",
  "notes": "رسید ارسال‌شده از تلگرام"
}

### Confirm payment by admin
POST {{ZibasheERP.API_HostAddress}}/api/payments/00000000-0000-0000-0000-000000000000/confirm
X-Api-Key: {{AdminApiKey}}

### List pending payments for admin
GET {{ZibasheERP.API_HostAddress}}/api/payments/pending?limit=50
Accept: application/json
X-Api-Key: {{AdminApiKey}}

### Reject payment by admin
POST {{ZibasheERP.API_HostAddress}}/api/payments/00000000-0000-0000-0000-000000000000/reject
Content-Type: application/json
X-Api-Key: {{AdminApiKey}}

{
  "reason": "شناسه تراکنش در بانک پیدا نشد."
}

### Refund confirmed payment by admin
POST {{ZibasheERP.API_HostAddress}}/api/payments/00000000-0000-0000-0000-000000000000/refund
Content-Type: application/json
X-Api-Key: {{AdminApiKey}}

{
  "reason": "لغو سفارش با درخواست مشتری"
}

### Issue invoice by admin
POST {{ZibasheERP.API_HostAddress}}/api/invoices/order/{{OrderId}}
X-Api-Key: {{AdminApiKey}}

### Get invoice for Telegram delivery
GET {{ZibasheERP.API_HostAddress}}/api/invoices/00000000-0000-0000-0000-000000000000
Accept: application/json
X-Api-Key: {{TelegramApiKey}}

### Register shipment by admin
POST {{ZibasheERP.API_HostAddress}}/api/shipments
Content-Type: application/json
X-Api-Key: {{AdminApiKey}}

{
  "orderId": "{{OrderId}}",
  "addressId": "00000000-0000-0000-0000-000000000000",
  "shippingCompany": "Post",
  "shippingCost": 150000,
  "trackingCode": "POST-TRACKING-001",
  "notes": "ارسال از انبار مرکزی"
}

### Mark shipment delivered
POST {{ZibasheERP.API_HostAddress}}/api/shipments/00000000-0000-0000-0000-000000000000/delivered
X-Api-Key: {{AdminApiKey}}

### Poll pending Telegram notifications
GET {{ZibasheERP.API_HostAddress}}/api/notifications/pending?limit=20
Accept: application/json
X-Api-Key: {{TelegramApiKey}}

### Simulate Telegram /orders webhook
POST {{ZibasheERP.API_HostAddress}}/api/telegram/webhook
Content-Type: application/json
X-Telegram-Bot-Api-Secret-Token: {{TelegramWebhookSecret}}

{
  "update_id": 10001,
  "message": {
    "text": "/orders",
    "chat": {
      "id": 123456789,
      "type": "private"
    },
    "from": {
      "id": 123456789,
      "username": "sample_customer"
    }
  }
}

### Simulate Telegram /lists webhook
POST {{ZibasheERP.API_HostAddress}}/api/telegram/webhook
Content-Type: application/json
X-Telegram-Bot-Api-Secret-Token: {{TelegramWebhookSecret}}

{
  "update_id": 10003,
  "message": {
    "text": "/lists",
    "chat": {
      "id": 123456789,
      "type": "private"
    },
    "from": {
      "id": 123456789,
      "username": "sample_customer"
    }
  }
}

### Simulate Telegram /addaddress
POST {{ZibasheERP.API_HostAddress}}/api/telegram/webhook
Content-Type: application/json
X-Telegram-Bot-Api-Secret-Token: {{TelegramWebhookSecret}}

{
  "update_id": 10005,
  "message": {
    "text": "/addaddress منزل | نام گیرنده | تهران | تهران | 1234567890 | نشانی کامل",
    "chat": {
      "id": 123456789,
      "type": "private"
    },
    "from": {
      "id": 123456789,
      "username": "sample_customer"
    }
  }
}

### Simulate Telegram contact sharing
POST {{ZibasheERP.API_HostAddress}}/api/telegram/webhook
Content-Type: application/json
X-Telegram-Bot-Api-Secret-Token: {{TelegramWebhookSecret}}

{
  "update_id": 10002,
  "message": {
    "chat": {
      "id": 123456789,
      "type": "private"
    },
    "from": {
      "id": 123456789,
      "username": "sample_customer"
    },
    "contact": {
      "phone_number": "+989120000000",
      "user_id": 123456789
    }
  }
}

### Simulate Telegram list-selection callback
POST {{ZibasheERP.API_HostAddress}}/api/telegram/webhook
Content-Type: application/json
X-Telegram-Bot-Api-Secret-Token: {{TelegramWebhookSecret}}

{
  "update_id": 10004,
  "callback_query": {
    "id": "callback-query-id",
    "from": {
      "id": 123456789,
      "username": "sample_customer"
    },
    "message": {
      "chat": {
        "id": 123456789,
        "type": "private"
      }
    },
    "data": "list:00000000000000000000000000000000"
  }
}

### Acknowledge a Telegram notification
POST {{ZibasheERP.API_HostAddress}}/api/notifications/00000000-0000-0000-0000-000000000000/processed
X-Api-Key: {{TelegramApiKey}}

### Report a Telegram notification failure
POST {{ZibasheERP.API_HostAddress}}/api/notifications/00000000-0000-0000-0000-000000000000/failed
Content-Type: application/json
X-Api-Key: {{TelegramApiKey}}

{
  "error": "Telegram API timeout"
}

###
### Get admin inventory overview
GET {{ZibasheERP.API_HostAddress}}/api/inventory?limit=100
X-Api-Key: {{AdminApiKey}}
### Get admin perfume catalog
GET {{ZibasheERP.API_HostAddress}}/api/perfumes?includeInactive=true&limit=100
X-Api-Key: {{AdminApiKey}}

### Create perfume
POST {{ZibasheERP.API_HostAddress}}/api/perfumes
Content-Type: application/json
X-Api-Key: {{AdminApiKey}}

{
  "name": "نام فارسی عطر",
  "englishName": "Perfume Name",
  "brand": "Brand",
  "pricePerMl": 250000,
  "originalBottleVolumeMl": 100,
  "notes": null
}
### Get purchase batches
GET {{ZibasheERP.API_HostAddress}}/api/batches?limit=100
X-Api-Key: {{AdminApiKey}}

### Create purchase batch
POST {{ZibasheERP.API_HostAddress}}/api/batches
Content-Type: application/json
X-Api-Key: {{AdminApiKey}}

{
  "perfumeId": "11111111-1111-1111-1111-111111111111",
  "batchNumber": "BATCH-002",
  "purchasePrice": 20000000,
  "totalVolumeMl": 100,
  "purchaseDate": "2026-08-02T00:00:00Z",
  "status": "Open"
}
### Get admin sales lists
GET {{ZibasheERP.API_HostAddress}}/api/sales-lists?limit=100
X-Api-Key: {{AdminApiKey}}

### Open sales list from a purchase batch
POST {{ZibasheERP.API_HostAddress}}/api/sales-lists
Content-Type: application/json
X-Api-Key: {{AdminApiKey}}

{
  "batchId": "22222222-2222-2222-2222-222222222222",
  "pricePerMl": 450000,
  "totalVolume": 100,
  "telegramChannelId": null,
  "notes": null
}

### Close sales list
POST {{ZibasheERP.API_HostAddress}}/api/sales-lists/00000000-0000-0000-0000-000000000000/close
X-Api-Key: {{AdminApiKey}}
### Get admin bottle catalog
GET {{ZibasheERP.API_HostAddress}}/api/bottles?includeInactive=true&limit=100
X-Api-Key: {{AdminApiKey}}

### Create bottle
POST {{ZibasheERP.API_HostAddress}}/api/bottles
Content-Type: application/json
X-Api-Key: {{AdminApiKey}}

{
  "name": "20ml Fancy Bottle",
  "volumeMl": 20,
  "type": 2,
  "salePrice": 150000,
  "isDefault": true,
  "notes": null
}

### Deactivate bottle
POST {{ZibasheERP.API_HostAddress}}/api/bottles/00000000-0000-0000-0000-000000000000/status
Content-Type: application/json
X-Api-Key: {{AdminApiKey}}

{
  "isActive": false
}
### Deactivate perfume
POST {{ZibasheERP.API_HostAddress}}/api/perfumes/00000000-0000-0000-0000-000000000000/status
Content-Type: application/json
X-Api-Key: {{AdminApiKey}}

{
  "isActive": false
}

### Update perfume price per ml
POST {{ZibasheERP.API_HostAddress}}/api/perfumes/00000000-0000-0000-0000-000000000000/price
Content-Type: application/json
X-Api-Key: {{AdminApiKey}}

{
  "pricePerMl": 275000
}
### Get business report (defaults to last 30 days)
GET {{ZibasheERP.API_HostAddress}}/api/reports/business?topLimit=10
X-Api-Key: {{AdminApiKey}}
### Search customers for admin (username, mobile, Telegram id, name)
GET {{ZibasheERP.API_HostAddress}}/api/customers/admin?search=sample_customer&debtOnly=false&limit=100
X-Api-Key: {{AdminApiKey}}

### Block customer
POST {{ZibasheERP.API_HostAddress}}/api/customers/00000000-0000-0000-0000-000000000000/access
Content-Type: application/json
X-Api-Key: {{AdminApiKey}}

{
  "isBlocked": true,
  "canPlaceOrder": false
}

### Set customer credit and wallet
POST {{ZibasheERP.API_HostAddress}}/api/customers/00000000-0000-0000-0000-000000000000/credit
Content-Type: application/json
X-Api-Key: {{AdminApiKey}}

{
  "creditLimit": 50000000,
  "walletBalance": 0
}
### Queue Telegram debt reminder
POST {{ZibasheERP.API_HostAddress}}/api/customers/00000000-0000-0000-0000-000000000000/debt-reminder
Content-Type: application/json
X-Api-Key: {{AdminApiKey}}

{
  "message": "لطفاً برای هماهنگی تسویه با پشتیبانی تماس بگیرید."
}
### Liveness health check
GET {{ZibasheERP.API_HostAddress}}/health/live
X-Correlation-ID: local-health-check

### Readiness health check (includes database)
GET {{ZibasheERP.API_HostAddress}}/health/ready
### Get shared customer account summary
GET {{ZibasheERP.API_HostAddress}}/api/customers/00000000-0000-0000-0000-000000000000/account
X-Api-Key: {{AdminApiKey}}
### Get failed Telegram notifications
GET {{ZibasheERP.API_HostAddress}}/api/notifications/failed?limit=50
X-Api-Key: {{AdminApiKey}}

### Retry failed Telegram notification
POST {{ZibasheERP.API_HostAddress}}/api/notifications/00000000-0000-0000-0000-000000000000/retry
X-Api-Key: {{AdminApiKey}}
### Get shipment tracking for Telegram customer
GET {{ZibasheERP.API_HostAddress}}/api/orders/tracking/ZS-ORDER-NUMBER/by-telegram/123456789
X-Api-Key: {{TelegramApiKey}}

### Preview Telegram group CSV import (does not write)
POST {{ZibasheERP.API_HostAddress}}/api/telegram-groups/import-csv?dryRun=true
X-Api-Key: {{AdminApiKey}}
Content-Type: multipart/form-data; boundary=ZibasheTelegramGroups

--ZibasheTelegramGroups
Content-Disposition: form-data; name="file"; filename="telegram-groups-current.csv"
Content-Type: text/csv

< ../tools/telegram-groups/output/telegram-groups-current.csv
--ZibasheTelegramGroups--

### Apply Telegram group CSV import (run only after reviewing dry run)
POST {{ZibasheERP.API_HostAddress}}/api/telegram-groups/import-csv?dryRun=false
X-Api-Key: {{AdminApiKey}}
Content-Type: multipart/form-data; boundary=ZibasheTelegramGroups

--ZibasheTelegramGroups
Content-Disposition: form-data; name="file"; filename="telegram-groups-current.csv"
Content-Type: text/csv

< ../tools/telegram-groups/output/telegram-groups-current.csv
--ZibasheTelegramGroups--
