{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zibashe.local/schemas/n8n/delivery-failure.schema.json",
  "title": "Telegram group delivery failure callback",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceEventId", "chatId", "error"],
  "properties": {
    "sourceEventId": { "type": "string", "format": "uuid" },
    "chatId": { "type": "string", "pattern": "^-[1-9][0-9]*$" },
    "error": { "type": "string", "minLength": 1, "maxLength": 1000 }
  }
}
